// PinIt's own controls, drawn from the Theme so they look the same on
// Windows 10 and 11 and in both colour modes. Each one takes keyboard focus,
// shows a focus ring, and tells screen readers what it is.

import { Theme, Icons } from "theme.slint";

export component Glyph inherits Path {
    in property <string> icon;
    in property <color> color: Theme.text;
    in property <length> size: 16px;
    commands: icon;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: color;
    stroke-width: 1.9px;
    stroke-line-cap: round;
}

export enum ButtonKind { primary, secondary, ghost, danger-ghost }

export component Button {
    in property <string> text;
    in property <string> icon;
    in property <ButtonKind> kind: secondary;
    in property <bool> enabled: true;
    in property <length> radius: 7px;
    in property <length> font-size: Theme.small;
    in property <string> tooltip;
    callback clicked;

    out property <bool> has-hover: touch.has-hover;
    property <bool> down: touch.pressed;

    preferred-height: 28px;
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: text != "" ? text : tooltip;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { root.clicked(); } }
    forward-focus: focus;

    bg := Rectangle {
        border-radius: root.radius;
        background: !enabled ? (kind == ButtonKind.primary ? Theme.track : transparent)
            : kind == ButtonKind.primary ? (down ? Theme.accent-hover : touch.has-hover ? Theme.accent-hover : Theme.accent-strong)
            : kind == ButtonKind.secondary ? (down ? Theme.raised.darker(4%) : touch.has-hover ? Theme.raised : Theme.card)
            : kind == ButtonKind.danger-ghost ? (touch.has-hover || focus.has-focus ? Theme.danger-soft : transparent)
            : (down ? Theme.raised.darker(4%) : touch.has-hover ? Theme.raised : transparent);
        border-width: kind == ButtonKind.secondary ? 1px : 0px;
        border-color: Theme.border;
        drop-shadow-blur: kind == ButtonKind.primary && enabled ? (touch.has-hover ? 8px : 4px) : 0px;
        drop-shadow-offset-y: kind == ButtonKind.primary ? 1px : 0px;
        drop-shadow-color: kind == ButtonKind.primary ? Theme.accent-strong.with-alpha(0.35) : transparent;
        animate background, drop-shadow-blur { duration: Theme.fast; easing: ease-out; }

        HorizontalLayout {
            padding-left: text == "" ? 0px : 10px;
            padding-right: text == "" ? 0px : 10px;
            spacing: 5px;
            alignment: center;

            if icon != "": Glyph {
                y: (parent.height - self.height) / 2;
                icon: root.icon;
                size: text == "" ? 14px : 13px;
                color: !enabled ? Theme.text-subtle
                    : kind == ButtonKind.primary ? Theme.on-accent
                    : kind == ButtonKind.danger-ghost && (touch.has-hover || focus.has-focus) ? Theme.danger
                    : kind == ButtonKind.ghost ? Theme.text-muted : Theme.text;
            }
            if text != "": Text {
                text: root.text;
                vertical-alignment: center;
                font-family: Theme.font;
                font-size: root.font-size;
                font-weight: kind == ButtonKind.primary ? 600 : 500;
                color: !enabled ? Theme.text-subtle
                    : kind == ButtonKind.primary ? Theme.on-accent
                    : kind == ButtonKind.ghost ? Theme.accent-hover : Theme.text;
            }
        }
    }

    // Focus ring, drawn just outside the button so nothing shifts.
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: root.radius + 3px;
        border-width: focus.has-focus && focus.focus-visible ? 2px : 0px;
        border-color: Theme.focus;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    focus := FocusScope {
        enabled: root.enabled;
        property <bool> focus-visible: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

// A square icon-only button (row actions, sheet close).
export component IconButton inherits Button {
    width: 24px;
    height: 24px;
    radius: 6px;
    kind: ghost;
}

export component CheckBox {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);

    min-height: 26px;
    accessible-role: checkbox;
    accessible-label: text;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => { root.toggle(); }
    forward-focus: focus;

    function toggle() {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        box := Rectangle {
            y: (parent.height - self.height) / 2;
            width: 15px;
            height: 15px;
            border-radius: 4px;
            background: checked ? (touch.has-hover ? Theme.accent-hover : Theme.accent-strong) : Theme.card;
            border-width: checked ? 0px : 1.5px;
            border-color: touch.has-hover || focus.has-focus ? Theme.accent-strong : Theme.text-subtle;
            animate background { duration: Theme.fast; }

            Glyph {
                icon: Icons.check;
                size: 12px;
                color: Theme.on-accent;
                opacity: checked ? 1 : 0;
                animate opacity { duration: Theme.fast; }
            }

            Rectangle {
                x: -3px;
                y: -3px;
                width: parent.width + 6px;
                height: parent.height + 6px;
                border-radius: 8px;
                border-width: focus.has-focus ? 2px : 0px;
                border-color: Theme.focus;
            }
        }

        Text {
            text: root.text;
            vertical-alignment: center;
            font-family: Theme.font;
            font-size: Theme.small;
            color: Theme.text;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                root.toggle();
                return accept;
            }
            reject
        }
    }
}

// Opacity slider. The position always shows `value`; dragging or the arrow
// keys ask for a new one through `changed`, and the owner decides.
export component Slider {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 5;
    in property <string> label;
    callback changed(int);

    min-width: 60px;
    height: 22px;
    accessible-role: slider;
    accessible-label: label;
    accessible-value: value + "%";
    accessible-value-minimum: minimum;
    accessible-value-maximum: maximum;
    accessible-value-step: step;
    accessible-action-increment => { root.request(value + step); }
    accessible-action-decrement => { root.request(value - step); }
    forward-focus: focus;

    property <float> ratio: (value - minimum) / max(1, maximum - minimum);
    property <length> thumb: 13px;
    property <bool> active: touch.pressed || touch.has-hover || focus.has-focus;

    function request(v: int) {
        root.changed(max(minimum, min(maximum, v)));
    }

    // Track
    Rectangle {
        x: thumb / 2;
        width: parent.width - thumb;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.track;
    }

    // Fill
    Rectangle {
        x: thumb / 2;
        width: (parent.width - thumb) * ratio;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.accent;
    }

    // Thumb
    Rectangle {
        x: (parent.width - thumb) * ratio;
        width: thumb;
        height: thumb;
        border-radius: thumb / 2;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.card-border;
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: Theme.shadow;

        Rectangle {
            width: touch.pressed ? 5px : active ? 7px : 6px;
            height: self.width;
            border-radius: self.width / 2;
            background: Theme.accent-strong;
            animate width { duration: Theme.fast; easing: ease-out; }
        }

        Rectangle {
            x: -3px;
            y: -3px;
            width: parent.width + 6px;
            height: parent.height + 6px;
            border-radius: self.width / 2;
            border-width: focus.has-focus ? 2px : 0px;
            border-color: Theme.focus;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        function apply(px: length) {
            root.request(minimum + round((maximum - minimum) * max(0, min(1, (px - thumb / 2) / (root.width - thumb)))));
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                focus.focus();
                self.apply(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                self.apply(self.mouse-x);
            }
        }
        scroll-event(event) => {
            if (event.delta-y > 0) {
                root.request(value + step);
            } else if (event.delta-y < 0) {
                root.request(value - step);
            }
            accept
        }
    }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.request(value + step);
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.request(value - step);
                return accept;
            }
            if (event.text == Key.Home) {
                root.request(minimum);
                return accept;
            }
            if (event.text == Key.End) {
                root.request(maximum);
                return accept;
            }
            reject
        }
    }
}

// A key cap: "Win", "Ctrl", "T".
export component KeyCap inherits Rectangle {
    in property <string> text;
    in property <bool> active: true;
    min-width: 20px;
    height: 19px;
    border-radius: 5px;
    background: active ? Theme.raised : transparent;
    border-width: 1px;
    border-color: active ? Theme.border : Theme.card-border;
    drop-shadow-offset-y: active ? 1px : 0px;
    drop-shadow-color: Theme.border;

    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        Text {
            text: root.text;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-family: Theme.font;
            font-size: 10px;
            font-weight: 650;
            color: active ? Theme.text : Theme.text-subtle;
        }
    }
}

// Keys joined by "+", e.g. [Win] + [Ctrl] + [T].
export component KeyCombo {
    in property <[string]> keys;
    in property <string> alt-key;   // shown as " / [key]" after the last key
    accessible-role: text;
    accessible-label: alt-key == "" ? "Shortcut" : "Shortcuts";

    HorizontalLayout {
        spacing: 3px;
        alignment: start;
        for key[i] in keys: HorizontalLayout {
            spacing: 3px;
            if i > 0: Text {
                text: "+";
                vertical-alignment: center;
                font-size: Theme.tiny;
                color: Theme.text-subtle;
            }
            KeyCap { text: key; }
        }
        if alt-key != "": Text {
            text: "/";
            vertical-alignment: center;
            font-size: Theme.tiny;
            color: Theme.text-subtle;
        }
        if alt-key != "": KeyCap { text: alt-key; }
    }
}

export component Card inherits Rectangle {
    in property <bool> hover-lift: false;
    in property <bool> hovered: false;
    background: hover-lift && hovered ? Theme.card-hover : Theme.card;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.card-border;
    drop-shadow-blur: hover-lift && hovered ? 8px : 2px;
    drop-shadow-offset-y: hover-lift && hovered ? 2px : 1px;
    drop-shadow-color: Theme.shadow;
    animate drop-shadow-blur, drop-shadow-offset-y, background { duration: Theme.medium; easing: ease-out; }
}

export component SectionTitle inherits Text {
    font-family: Theme.font;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
    color: Theme.text-muted;
    accessible-role: text;
}

// The app's icon, or a pastel tile with its initial when it has none.
export component AppAvatar inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon;
    in property <string> initial;
    in property <color> tint;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: has-icon ? Theme.raised : tint;
    clip: true;

    if has-icon: Image {
        source: icon;
        width: 18px;
        height: 18px;
        image-rendering: smooth;
    }
    if !has-icon: Text {
        text: initial;
        font-family: Theme.display-font;
        font-size: 12px;
        font-weight: 700;
        color: #2a2622;
    }
}

// A dimmed backdrop with a card that slides up from the bottom. Closes on
// Escape or a click outside.
export component Sheet {
    in property <bool> open;
    in property <string> title;
    in property <length> sheet-height: 520px;
    callback close();

    // Covers whatever it is placed in.
    x: 0;
    y: 0;
    width: 100%;
    height: 100%;
    visible: self.opacity > 0.01;
    opacity: open ? 1 : 0;
    animate opacity { duration: Theme.medium; easing: ease-out; }

    Rectangle {
        background: Theme.scrim;
        TouchArea {
            clicked => { root.close(); }
        }
    }

    panel := Rectangle {
        x: 8px;
        width: parent.width - 16px;
        height: min(root.sheet-height, root.height - 16px);
        y: open ? parent.height - self.height - 8px : parent.height;
        animate y { duration: Theme.medium; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
        border-radius: 12px;
        background: Theme.window;
        border-width: 1px;
        border-color: Theme.card-border;
        drop-shadow-blur: 30px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000040;

        TouchArea { }   // keep clicks on the sheet from closing it

        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close();
                    return accept;
                }
                reject
            }

            VerticalLayout {
                padding: 12px;
                padding-top: 10px;
                spacing: 9px;

                HorizontalLayout {
                    Text {
                        text: root.title;
                        vertical-alignment: center;
                        font-family: Theme.display-font;
                        font-size: 14px;
                        font-weight: 650;
                        color: Theme.text;
                        accessible-role: text;
                    }
                    IconButton {
                        icon: Icons.close;
                        tooltip: "Close";
                        clicked => { root.close(); }
                    }
                }
                @children
            }
        }
    }
}
