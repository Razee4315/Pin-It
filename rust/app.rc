// Windows resources for PinIt: the exe icon, file metadata (Properties ->
// Details) and the application manifest.
#include <windows.h>

1 ICON "../resources/icon.ico"
1 RT_MANIFEST "pinit.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    3,0,0,0
PRODUCTVERSION 3,0,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS__WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Saqlain Abbas"
            VALUE "FileDescription",  "PinIt - keep any window always on top"
            VALUE "FileVersion",      "3.0.0-alpha.1"
            VALUE "InternalName",     "PinIt"
            VALUE "LegalCopyright",   "Copyright (C) Saqlain Abbas. Apache-2.0."
            VALUE "OriginalFilename", "PinIt.exe"
            VALUE "ProductName",      "PinIt"
            VALUE "ProductVersion",   "3.0.0-alpha.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
