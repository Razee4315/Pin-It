// Windows resources for PinIt: the exe icon, file metadata (Properties ->
// Details) and the application manifest. build.rs fills in the @PLACEHOLDERS@:
// the version from Cargo.toml, and absolute paths to the icon and manifest.
#include <windows.h>

1 ICON "@ICON@"
1 RT_MANIFEST "@MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    @VERSION_NUMERIC@
PRODUCTVERSION @VERSION_NUMERIC@
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS__WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Saqlain Abbas"
            VALUE "FileDescription",  "PinIt - keep any window always on top"
            VALUE "FileVersion",      "@VERSION@"
            VALUE "InternalName",     "PinIt"
            VALUE "LegalCopyright",   "Copyright (C) Saqlain Abbas. Apache-2.0."
            VALUE "OriginalFilename", "PinIt.exe"
            VALUE "ProductName",      "PinIt"
            VALUE "ProductVersion",   "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
